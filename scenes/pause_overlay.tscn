[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/pause_overlay.gd" id="1_pause"]

[node name="PauseOverlay" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1
script = ExtResource("1_pause")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.043, 0.063, 0.125, 0.85)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Column" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 32

[node name="Title" type="Label" parent="Center/Column"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.788, 0.42, 1)
theme_override_font_sizes/font_size = 56
text = "Paused"
horizontal_alignment = 1

[node name="ResumeButton" type="Button" parent="Center/Column"]
custom_minimum_size = Vector2(320, 100)
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 32
text = "Resume"

[node name="RestartButton" type="Button" parent="Center/Column"]
custom_minimum_size = Vector2(320, 88)
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 28
text = "Restart"

[node name="MenuButton" type="Button" parent="Center/Column"]
custom_minimum_size = Vector2(320, 88)
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 28
text = "Main Menu"

[connection signal="pressed" from="Center/Column/ResumeButton" to="." method="_on_resume_pressed"]
[connection signal="pressed" from="Center/Column/RestartButton" to="." method="_on_restart_pressed"]
[connection signal="pressed" from="Center/Column/MenuButton" to="." method="_on_menu_pressed"]
