[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/sign_in_screen.gd" id="1_signin"]

[node name="SignInScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_signin")

[node name="Background" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_type_variation = &"ScreenBackground"

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 54
theme_override_constants/margin_top = 36
theme_override_constants/margin_right = 54
theme_override_constants/margin_bottom = 36

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 0

[node name="TopBar" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2

[node name="BackButton" type="Button" parent="Margin/Column/TopBar"]
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
theme_type_variation = &"BackButton"
text = "Back"
alignment = 0

[node name="Scroll" type="ScrollContainer" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Content" type="VBoxContainer" parent="Margin/Column/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margin/Column/Scroll/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Heading"
text = "Sign in"

[node name="AccountNote" type="Label" parent="Margin/Column/Scroll/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Muted"
autowrap_mode = 3
text = "Accounts sync your best score and appear on the leaderboard."

[node name="Gap" type="Control" parent="Margin/Column/Scroll/Content"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
mouse_filter = 2

[node name="Form" type="VBoxContainer" parent="Margin/Column/Scroll/Content"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="EmailBlock" type="VBoxContainer" parent="Margin/Column/Scroll/Content/Form"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="EmailCaption" type="Label" parent="Margin/Column/Scroll/Content/Form/EmailBlock"]
layout_mode = 2
theme_type_variation = &"StatCaption"
text = "EMAIL"

[node name="EmailField" type="LineEdit" parent="Margin/Column/Scroll/Content/Form/EmailBlock"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 84)
layout_mode = 2
virtual_keyboard_type = 5

[node name="UsernameBlock" type="VBoxContainer" parent="Margin/Column/Scroll/Content/Form"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 8

[node name="UsernameCaption" type="Label" parent="Margin/Column/Scroll/Content/Form/UsernameBlock"]
layout_mode = 2
theme_type_variation = &"StatCaption"
text = "USERNAME, 3 TO 20 CHARACTERS"

[node name="UsernameField" type="LineEdit" parent="Margin/Column/Scroll/Content/Form/UsernameBlock"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 84)
layout_mode = 2
max_length = 20

[node name="PasswordBlock" type="VBoxContainer" parent="Margin/Column/Scroll/Content/Form"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="PasswordCaption" type="Label" parent="Margin/Column/Scroll/Content/Form/PasswordBlock"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"StatCaption"
text = "PASSWORD, 8 OR MORE CHARACTERS"

[node name="PasswordField" type="LineEdit" parent="Margin/Column/Scroll/Content/Form/PasswordBlock"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 84)
layout_mode = 2
secret = true

[node name="StatusLabel" type="Label" parent="Margin/Column/Scroll/Content/Form"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"FormError"
autowrap_mode = 3

[node name="SubmitButton" type="Button" parent="Margin/Column/Scroll/Content/Form"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
theme_type_variation = &"PrimaryButton"
text = "Sign in"

[node name="ModeButton" type="Button" parent="Margin/Column/Scroll/Content/Form"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 84)
layout_mode = 2
theme_type_variation = &"TextButton"
text = "Create account"

[connection signal="pressed" from="Margin/Column/TopBar/BackButton" to="." method="_on_back_pressed"]
[connection signal="pressed" from="Margin/Column/Scroll/Content/Form/SubmitButton" to="." method="_on_submit_pressed"]
[connection signal="pressed" from="Margin/Column/Scroll/Content/Form/ModeButton" to="." method="_on_mode_pressed"]
