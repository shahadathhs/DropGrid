layout_mode = 2
theme_type_variation = &"DangerButton"
text = "Delete account"

[node name="CancelDeleteButton" type="Button" parent="Margin/Column/Actions/ConfirmBox/ConfirmItems"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 60)
layout_mode = 2
theme_type_variation = &"TextButton"
text = "Cancel"

[node name="SettingsOverlay" parent="." instance=ExtResource("2_settings")]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[connection signal="pressed" from="Margin/Column/TopBar/BackButton" to="." method="_on_back_pressed"]
[connection signal="pressed" from="Margin/Column/TopBar/SettingsButton" to="." method="_on_settings_pressed"]
[connection signal="pressed" from="Margin/Column/RenameRow/RenameButton" to="." method="_on_rename_pressed"]
[connection signal="pressed" from="Margin/Column/Actions/CreateProfileButton" to="." method="_on_create_profile_pressed"]
[connection signal="pressed" from="Margin/Column/Actions/SignOutButton" to="." method="_on_sign_out_pressed"]
[connection signal="pressed" from="Margin/Column/Actions/DeleteButton" to="." method="_on_delete_pressed"]
[connection signal="pressed" from="Margin/Column/Actions/ConfirmBox/ConfirmItems/ConfirmDeleteButton" to="." method="_on_confirm_delete_pressed"]
[connection signal="pressed" from="Margin/Column/Actions/ConfirmBox/ConfirmItems/CancelDeleteButton" to="." method="_on_cancel_delete_pressed"]
