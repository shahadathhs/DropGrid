anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Icon" type="TextureRect" parent="Margin/Column/TopBar/SettingsButton/IconCenter"]
custom_minimum_size = Vector2(26, 26)
layout_mode = 2
mouse_filter = 2
texture = ExtResource("4_gear")
expand_mode = 1
stretch_mode = 5

[node name="IdentityTop" type="Control" parent="Margin/Column"]
custom_minimum_size = Vector2(0, 27)
layout_mode = 2
mouse_filter = 2

[node name="Identity" type="VBoxContainer" parent="Margin/Column"]
layout_mode = 2
