[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/profile_screen.gd" id="1_profile"]
[ext_resource type="PackedScene" path="res://scenes/settings_overlay.tscn" id="2_settings"]
[ext_resource type="Texture2D" path="res://assets/icons/settings.svg" id="4_gear"]

[node name="ProfileScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_profile")

[node name="Background" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_type_variation = &"ScreenBackground"

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 54
theme_override_constants/margin_top = 36
theme_override_constants/margin_right = 54
theme_override_constants/margin_bottom = 36

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 0

[node name="TopBar" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2

[node name="BackButton" type="Button" parent="Margin/Column/TopBar"]
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
theme_type_variation = &"BackButton"
text = "Back"
alignment = 0

[node name="TopFill" type="Control" parent="Margin/Column/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="SettingsButton" type="Button" parent="Margin/Column/TopBar"]
custom_minimum_size = Vector2(96, 96)
layout_mode = 2
theme_type_variation = &"IconButton"
theme_override_constants/icon_max_width = 36
icon = ExtResource("4_gear")
icon_alignment = 1
expand_icon = true

[node name="Scroll" type="ScrollContainer" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Content" type="VBoxContainer" parent="Margin/Column/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="UsernameLabel" type="Label" parent="Margin/Column/Scroll/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Heading"
clip_text = true
text = "Guest"

[node name="SubtitleLabel" type="Label" parent="Margin/Column/Scroll/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Muted"
autowrap_mode = 3
text = "Saved on this device"

[node name="Gap" type="Control" parent="Margin/Column/Scroll/Content"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
mouse_filter = 2

[node name="StatRow" type="HBoxContainer" parent="Margin/Column/Scroll/Content"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="BestStat" type="VBoxContainer" parent="Margin/Column/Scroll/Content/StatRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="BestCaption" type="Label" parent="Margin/Column/Scroll/Content/StatRow/BestStat"]
layout_mode = 2
theme_type_variation = &"StatCaption"
text = "BEST"

[node name="BestValue" type="Label" parent="Margin/Column/Scroll/Content/StatRow/BestStat"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"StatValue"
text = "0"

[node name="LinesStat" type="VBoxContainer" parent="Margin/Column/Scroll/Content/StatRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="LinesCaption" type="Label" parent="Margin/Column/Scroll/Content/StatRow/LinesStat"]
layout_mode = 2
theme_type_variation = &"StatCaption"
text = "LINES"

[node name="LinesValue" type="Label" parent="Margin/Column/Scroll/Content/StatRow/LinesStat"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"StatValue"
text = "0"

[node name="GamesStat" type="VBoxContainer" parent="Margin/Column/Scroll/Content/StatRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="GamesCaption" type="Label" parent="Margin/Column/Scroll/Content/StatRow/GamesStat"]
layout_mode = 2
theme_type_variation = &"StatCaption"
text = "GAMES"

[node name="GamesValue" type="Label" parent="Margin/Column/Scroll/Content/StatRow/GamesStat"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"StatValue"
text = "0"

[node name="Gap2" type="Control" parent="Margin/Column/Scroll/Content"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
mouse_filter = 2

[node name="Actions" type="VBoxContainer" parent="Margin/Column/Scroll/Content"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="CreateProfileButton" type="Button" parent="Margin/Column/Scroll/Content/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
theme_type_variation = &"PrimaryButton"
text = "Create account"

[node name="RenameCaption" type="Label" parent="Margin/Column/Scroll/Content/Actions"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"StatCaption"
text = "NEW USERNAME"

[node name="NameField" type="LineEdit" parent="Margin/Column/Scroll/Content/Actions"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(0, 84)
layout_mode = 2
max_length = 20

[node name="RenameButton" type="Button" parent="Margin/Column/Scroll/Content/Actions"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
theme_type_variation = &"SecondaryButton"
text = "Rename"

[node name="SignOutButton" type="Button" parent="Margin/Column/Scroll/Content/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
theme_type_variation = &"SecondaryButton"
text = "Sign out"

[node name="StatusLabel" type="Label" parent="Margin/Column/Scroll/Content/Actions"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"FormError"
autowrap_mode = 3

[node name="DeleteButton" type="Button" parent="Margin/Column/Scroll/Content/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 84)
layout_mode = 2
theme_type_variation = &"DangerTextButton"
text = "Delete account"

[node name="ConfirmBox" type="VBoxContainer" parent="Margin/Column/Scroll/Content/Actions"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 18

[node name="ConfirmText" type="Label" parent="Margin/Column/Scroll/Content/Actions/ConfirmBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Muted"
autowrap_mode = 3
text = "Your synced stats and leaderboard entry will be removed. This cannot be undone. Stats on this device stay."

[node name="ConfirmDeleteButton" type="Button" parent="Margin/Column/Scroll/Content/Actions/ConfirmBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
theme_type_variation = &"DangerButton"
text = "Delete"

[node name="CancelDeleteButton" type="Button" parent="Margin/Column/Scroll/Content/Actions/ConfirmBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 84)
layout_mode = 2
theme_type_variation = &"TextButton"
text = "Cancel"

[node name="SettingsOverlay" parent="." instance=ExtResource("2_settings")]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[connection signal="pressed" from="Margin/Column/TopBar/BackButton" to="." method="_on_back_pressed"]
[connection signal="pressed" from="Margin/Column/TopBar/SettingsButton" to="." method="_on_settings_pressed"]
[connection signal="pressed" from="Margin/Column/Scroll/Content/Actions/RenameButton" to="." method="_on_rename_pressed"]
[connection signal="pressed" from="Margin/Column/Scroll/Content/Actions/CreateProfileButton" to="." method="_on_create_profile_pressed"]
[connection signal="pressed" from="Margin/Column/Scroll/Content/Actions/SignOutButton" to="." method="_on_sign_out_pressed"]
[connection signal="pressed" from="Margin/Column/Scroll/Content/Actions/DeleteButton" to="." method="_on_delete_pressed"]
[connection signal="pressed" from="Margin/Column/Scroll/Content/Actions/ConfirmBox/ConfirmDeleteButton" to="." method="_on_confirm_delete_pressed"]
[connection signal="pressed" from="Margin/Column/Scroll/Content/Actions/ConfirmBox/CancelDeleteButton" to="." method="_on_cancel_delete_pressed"]
