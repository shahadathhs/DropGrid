[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/profile_screen.gd" id="1_profile"]
[ext_resource type="PackedScene" path="res://scenes/settings_overlay.tscn" id="2_settings"]
[ext_resource type="Texture2D" path="res://assets/icons/arrow_left.svg" id="3_back"]
[ext_resource type="Texture2D" path="res://assets/icons/settings.svg" id="4_gear"]

[node name="ProfileScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_profile")

[node name="Background" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_type_variation = &"ScreenBackground"

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 24

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 0

[node name="TopBar" type="HBoxContainer" parent="Margin/Column"]
custom_minimum_size = Vector2(0, 57)
layout_mode = 2

[node name="BackButton" type="Button" parent="Margin/Column/TopBar"]
custom_minimum_size = Vector2(57, 57)
layout_mode = 2
theme_type_variation = &"IconButton"
tooltip_text = "Go back"

[node name="IconCenter" type="CenterContainer" parent="Margin/Column/TopBar/BackButton"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Icon" type="TextureRect" parent="Margin/Column/TopBar/BackButton/IconCenter"]
custom_minimum_size = Vector2(26, 26)
layout_mode = 2
mouse_filter = 2
texture = ExtResource("3_back")
expand_mode = 1
stretch_mode = 5

[node name="Title" type="Label" parent="Margin/Column/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Title"
horizontal_alignment = 1
vertical_alignment = 1
text = "Profile"

[node name="SettingsButton" type="Button" parent="Margin/Column/TopBar"]
custom_minimum_size = Vector2(57, 57)
layout_mode = 2
theme_type_variation = &"IconButton"
tooltip_text = "Settings"

[node name="IconCenter" type="CenterContainer" parent="Margin/Column/TopBar/SettingsButton"]
layout_mode = 1
