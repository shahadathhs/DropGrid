layout_mode = 2
theme_type_variation = &"StrongCard"

[node name="ConfirmItems" type="VBoxContainer" parent="Margin/Column/Actions/ConfirmBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="ConfirmTitle" type="Label" parent="Margin/Column/Actions/ConfirmBox/ConfirmItems"]
layout_mode = 2
theme_type_variation = &"Title"
text = "Delete your account?"

[node name="ConfirmText" type="Label" parent="Margin/Column/Actions/ConfirmBox/ConfirmItems"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Muted"
autowrap_mode = 3
text = "Your synced stats and leaderboard entry will be removed. This cannot be undone. Stats on this device stay."

[node name="ConfirmDeleteButton" type="Button" parent="Margin/Column/Actions/ConfirmBox/ConfirmItems"]
unique_name_in_owner = true
