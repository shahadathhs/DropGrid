[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/leaderboard_screen.gd" id="1_board"]

[node name="LeaderboardScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_board")

[node name="Background" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_type_variation = &"ScreenBackground"

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 54
theme_override_constants/margin_top = 36
theme_override_constants/margin_right = 54
theme_override_constants/margin_bottom = 48

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="BackRow" type="MarginContainer" parent="Margin/Column"]
layout_mode = 2
mouse_filter = 2

[node name="BackButton" type="Button" parent="Margin/Column/BackRow"]
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
size_flags_horizontal = 0
theme_type_variation = &"BackButton"
text = "Back"

[node name="Title" type="Label" parent="Margin/Column"]
layout_mode = 2
theme_type_variation = &"Heading"
text = "LEADERBOARD"

[node name="Gap" type="Control" parent="Margin/Column"]
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
mouse_filter = 2

[node name="StatusBox" type="VBoxContainer" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 24

[node name="StatusLabel" type="Label" parent="Margin/Column/StatusBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Muted"
autowrap_mode = 3
text = "Loading"

[node name="RetryButton" type="Button" parent="Margin/Column/StatusBox"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(0, 108)
layout_mode = 2
theme_type_variation = &"SecondaryButton"
text = "Retry"

[node name="Scroll" type="ScrollContainer" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
vertical_scroll_mode = 3

[node name="RowList" type="VBoxContainer" parent="Margin/Column/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 0

[node name="SignInBox" type="VBoxContainer" parent="Margin/Column"]
unique_name_in_owner = true
visible = false
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="NoteLabel" type="Label" parent="Margin/Column/SignInBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Muted"
text = "Sign in to appear here"

[node name="SignInButton" type="Button" parent="Margin/Column/SignInBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 132)
layout_mode = 2
theme_type_variation = &"PrimaryButton"
theme_override_font_sizes/font_size = 30
text = "Sign in"

[connection signal="pressed" from="Margin/Column/BackRow/BackButton" to="." method="_on_back_pressed"]
[connection signal="pressed" from="Margin/Column/StatusBox/RetryButton" to="." method="_on_retry_pressed"]
[connection signal="pressed" from="Margin/Column/SignInBox/SignInButton" to="." method="_on_sign_in_pressed"]
