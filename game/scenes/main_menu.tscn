[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/hero_board.gd" id="4_hero"]

[ext_resource type="Script" path="res://scripts/main_menu.gd" id="1_s"]
[ext_resource type="PackedScene" path="res://scenes/settings_overlay.tscn" id="2_settings"]
[ext_resource type="Script" path="res://scripts/wordmark.gd" id="3_word"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_s")

[node name="Background" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_type_variation = &"ScreenBackground"

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 54
theme_override_constants/margin_top = 72
theme_override_constants/margin_right = 54
theme_override_constants/margin_bottom = 48

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="TopSpacer" type="Control" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2

[node name="Wordmark" type="Control" parent="Margin/Column"]
custom_minimum_size = Vector2(0, 430)
layout_mode = 2
mouse_filter = 2
script = ExtResource("3_word")

[node name="HeroBoard" type="Control" parent="Margin/Column"]
layout_mode = 2
size_flags_horizontal = 4
script = ExtResource("4_hero")

[node name="Gap" type="Control" parent="Margin/Column"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
mouse_filter = 2

[node name="BestCaption" type="Label" parent="Margin/Column"]
layout_mode = 2
theme_type_variation = &"StatCaption"
horizontal_alignment = 1
text = "BEST"

[node name="BestLabel" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Best"
horizontal_alignment = 1
text = "0"

[node name="BottomSpacer" type="Control" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2

[node name="PlayButton" type="Button" parent="Margin/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 132)
layout_mode = 2
theme_type_variation = &"PrimaryButton"
theme_override_font_sizes/font_size = 30
text = "Play"

[node name="Links" type="VBoxContainer" parent="Margin/Column"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 0

[node name="LinksRow1" type="HBoxContainer" parent="Margin/Column/Links"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 0

[node name="LinksRow2" type="HBoxContainer" parent="Margin/Column/Links"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 0

[node name="StatsButton" type="Button" parent="Margin/Column/Links/LinksRow1"]
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"TextButton"
theme_override_font_sizes/font_size = 18
text = "Stats"

[node name="LevelsButton" type="Button" parent="Margin/Column/Links/LinksRow1"]
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"TextButton"
theme_override_font_sizes/font_size = 18
text = "Levels"

[node name="LeaderboardButton" type="Button" parent="Margin/Column/Links/LinksRow1"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"TextButton"
theme_override_font_sizes/font_size = 18
text = "Leaderboard"

[node name="AccountButton" type="Button" parent="Margin/Column/Links/LinksRow2"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"TextButton"
theme_override_font_sizes/font_size = 18
text = "Sign in"

[node name="SettingsButton" type="Button" parent="Margin/Column/Links/LinksRow2"]
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"TextButton"
theme_override_font_sizes/font_size = 18
text = "Settings"

[node name="SettingsOverlay" parent="." instance=ExtResource("2_settings")]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[connection signal="pressed" from="Margin/Column/PlayButton" to="." method="_on_play_pressed"]
[connection signal="pressed" from="Margin/Column/Links/LinksRow1/StatsButton" to="." method="_on_stats_pressed"]
[connection signal="pressed" from="Margin/Column/Links/LinksRow1/LevelsButton" to="." method="_on_levels_pressed"]
[connection signal="pressed" from="Margin/Column/Links/LinksRow1/LeaderboardButton" to="." method="_on_leaderboard_pressed"]
[connection signal="pressed" from="Margin/Column/Links/LinksRow2/AccountButton" to="." method="_on_account_pressed"]
[connection signal="pressed" from="Margin/Column/Links/LinksRow2/SettingsButton" to="." method="_on_settings_pressed"]
