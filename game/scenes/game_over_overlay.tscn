[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/game_over_overlay.gd" id="1_s"]

[node name="GameOverOverlay" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1
script = ExtResource("1_s")

[node name="Background" type="Panel" parent="."]
layout_mode = 1
