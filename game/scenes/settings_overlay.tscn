[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/settings_overlay.gd" id="1_settings"]
[ext_resource type="Script" path="res://scripts/toggle_switch.gd" id="2_switch"]

[node name="SettingsOverlay" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1
script = ExtResource("1_settings")

[node name="Background" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_type_variation = &"ScreenBackground"

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 54
theme_override_constants/margin_top = 36
theme_override_constants/margin_right = 54
theme_override_constants/margin_bottom = 36

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2

[node name="CloseButton" type="Button" parent="Margin/Column"]
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
size_flags_horizontal = 0
theme_type_variation = &"BackButton"
text = "Back"

[node name="Gap" type="Control" parent="Margin/Column"]
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
mouse_filter = 2

[node name="Title" type="Label" parent="Margin/Column"]
layout_mode = 2
theme_type_variation = &"Heading"
text = "Settings"

[node name="Gap2" type="Control" parent="Margin/Column"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
mouse_filter = 2

[node name="List" type="VBoxContainer" parent="Margin/Column"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="SoundToggle" type="Button" parent="Margin/Column/List"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
theme_type_variation = &"TextButton"
toggle_mode = true
flat = true
focus_mode = 0

[node name="Row" type="HBoxContainer" parent="Margin/Column/List/SoundToggle"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Text" type="VBoxContainer" parent="Margin/Column/List/SoundToggle/Row"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
mouse_filter = 2
theme_override_constants/separation = 4

[node name="SoundName" type="Label" parent="Margin/Column/List/SoundToggle/Row/Text"]
layout_mode = 2
text = "Sound"

[node name="SoundSwitch" type="Control" parent="Margin/Column/List/SoundToggle/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
script = ExtResource("2_switch")

[node name="HapticsToggle" type="Button" parent="Margin/Column/List"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
theme_type_variation = &"TextButton"
toggle_mode = true
flat = true
focus_mode = 0

[node name="Row" type="HBoxContainer" parent="Margin/Column/List/HapticsToggle"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Text" type="VBoxContainer" parent="Margin/Column/List/HapticsToggle/Row"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
mouse_filter = 2
theme_override_constants/separation = 4

[node name="HapticsName" type="Label" parent="Margin/Column/List/HapticsToggle/Row/Text"]
layout_mode = 2
text = "Haptics"

[node name="HapticsHint" type="Label" parent="Margin/Column/List/HapticsToggle/Row/Text"]
layout_mode = 2
theme_type_variation = &"Muted"
text = "Vibrate on line clears"

[node name="HapticsSwitch" type="Control" parent="Margin/Column/List/HapticsToggle/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
script = ExtResource("2_switch")

[connection signal="pressed" from="Margin/Column/CloseButton" to="." method="_on_close_pressed"]
