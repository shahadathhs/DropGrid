[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/levels_screen.gd" id="1_levels"]

[node name="LevelsScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_levels")

[node name="Background" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_type_variation = &"ScreenBackground"

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 54
theme_override_constants/margin_top = 36
theme_override_constants/margin_right = 54
theme_override_constants/margin_bottom = 48

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="BackRow" type="MarginContainer" parent="Margin/Column"]
layout_mode = 2
mouse_filter = 2

[node name="BackButton" type="Button" parent="Margin/Column/BackRow"]
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
size_flags_horizontal = 0
theme_type_variation = &"BackButton"
text = "Back"

[node name="Title" type="Label" parent="Margin/Column"]
layout_mode = 2
theme_type_variation = &"Heading"
text = "START LEVEL"

[node name="Gap" type="Control" parent="Margin/Column"]
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
mouse_filter = 2

[node name="Scroll" type="ScrollContainer" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
vertical_scroll_mode = 3

[node name="LevelTree" type="GridContainer" parent="Margin/Column/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 12
columns = 2

[node name="NeedsLabel" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 30)
layout_mode = 2
theme_type_variation = &"Muted"
text = ""

[node name="SummaryLabel" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"StatCaption"
text = "0 LINES CLEARED"

[connection signal="pressed" from="Margin/Column/BackRow/BackButton" to="." method="_on_back_pressed"]
