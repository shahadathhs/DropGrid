extends Node
## Autoload singleton ("Music"): looping tracks routed to the Music bus. The
## loops are original tones generated by scripts/make_music.py — no licensing.

const TRACKS := {
	"menu": preload("res://assets/audio/music/menu.wav"),
	"gameplay": preload("res://assets/audio/music/gameplay.wav"),
	"zen": preload("res://assets/audio/music/zen.wav"),
}

var _player: AudioStreamPlayer
var _current := ""


func _ready() -> void:
	# The Music bus comes from res://default_bus_layout.tres (see sfx.gd for why it is
	# never created in code).
	_player = AudioStreamPlayer.new()
	_player.bus = "Music"
	add_child(_player)
	update_buses()


## True when a loop should be audible: the setting is on and the track exists.
static func should_play(enabled: bool, track: String) -> bool:
	return enabled and TRACKS.has(track)


## Asks for a track. It starts only if music is enabled; otherwise the choice is
## remembered, so turning music on later starts it.
func play(track: String) -> void:
	_current = track
	_sync_player()


func stop() -> void:
	_current = ""
	_player.stop()


## Applies the saved music toggle: mutes or unmutes the bus, then starts or stops
## the current loop to match. Called by the settings screen.
func update_buses() -> void:
	var index := AudioServer.get_bus_index("Music")
	if index >= 0:
		AudioServer.set_bus_mute(index, not Save.music_enabled)
	_sync_player()


## The one place that decides whether the loop is playing: it follows the setting
## and the requested track, whichever of them changed last.
func _sync_player() -> void:
	if not should_play(Save.music_enabled, _current):
		_player.stop()
		return
	var stream: AudioStreamWAV = TRACKS[_current]
	if _player.playing and _player.stream == stream:
		return
	stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
	stream.loop_begin = 0
	stream.loop_end = stream.data.size() / 2  # frames: 16-bit mono, 2 bytes per frame
	_player.stream = stream
	_player.play()
