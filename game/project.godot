; Engine configuration file.
config_version=5

[application]

config/name="DropGrid"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

Save="*res://autoload/save.gd"
Sfx="*res://autoload/sfx.gd"
Music="*res://autoload/music.gd"
Sync="*res://autoload/sync.gd"
DevicePreview="*res://autoload/device_preview.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=390
window/size/window_height_override=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom="res://resources/game_theme.tres"

[dropgrid]

network/api_base_url="http://localhost:8000/v1"
network/api_base_url.release=""

[rendering]

environment/defaults/default_clear_color=Color(0.086, 0.082, 0.075, 1)
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
