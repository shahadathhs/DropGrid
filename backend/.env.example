# Copy to backend/.env (git-ignored) and fill in. Read by core/config.py.

# Local Postgres from Docker Compose (make db-up):
DATABASE_URL=postgresql://dropgrid:dropgrid@localhost:5432/dropgrid

# Neon (production). Paste the URL from the Neon console as-is; it is converted
# for asyncpg automatically. Keep it out of git.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require

# Without DATABASE_URL the backend uses a local SQLite file (backend/dropgrid.db).

# Set a real secret before any deployment. The default is for local development only.
JWT_SECRET=change-me-to-a-long-random-string-32-bytes-min
